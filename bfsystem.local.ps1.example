# ==========================================================
# Copy this file to bfsystem.local.ps1 (same folder) and fill in real
# values. bfsystem.local.ps1 is gitignored -- bfsystem.local.ps1.example
# (this file) is the only one that should ever be committed.
# ==========================================================

# Local admin login password for the bfweb dashboard (paired with
# $adminUsername in bfsystem.ps1). Generate one with:
#   openssl rand -hex 24
$adminPassword = "REPLACE_WITH_A_REAL_RANDOM_PASSWORD"

# Discord OAuth2 app credentials (from https://discord.com/developers/applications
# -> your app -> OAuth2 -> General). Leave both blank to disable Discord login
# (only local admin login will be available).
$discordClientId     = ""
$discordClientSecret = ""

# X-API-Key from DCSServerBot's restapi.yaml (the `api_key` value). Pairs
# with $dcsServerBotUrl in bfsystem.ps1 -- both must be set for Discord
# account linking (dashboard "My Profile", cockpit UI) to work.
$dcsServerBotApiKey = ""

# Ciribob DCS-SRS HTTP API key — must match HTTP_SERVER_API_KEY in
# Saved Games\...\Config\SRS.cfg for the instance bfdb proxies ($srsUrl).
# bfdb sends it as the X-API-KEY header on GET {srsUrl}/clients.
# Leave blank only if that SRS.cfg key is also blank (header is still sent).
$srsApiKey = ""

# Optional: override $netidxBase from bfsystem.ps1 (must match CFG netidx_base).
# Leave unset to keep the default "/local/fowl/campaign". Set to "" only if
# you intentionally want bfdb without --base.
# $netidxBase = "/local/fowl/campaign"
