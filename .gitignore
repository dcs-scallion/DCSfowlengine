# DCS / mission: local archives & scratch (not versioned; use backup disk or release assets)
miz/Scenarios/**/base.miz
# Exception: base.miz inside folders whose name starts with sample (published with the sample campaign)
!miz/Scenarios/**/sample*/base.miz
miz/Scenarios/80s/Caucasus1985-SARH/Rust_Fowl_Engine_2.0_Caucasus1985-SARH.miz
# Mission CFG JSON lives on the DCS host / backup — do not push updates (history may still have older copies)
miz/**/*_CFG
*.7z
*.rar
*.zip
# Build / local run logs (e.g. ! build-and-copy-mission-LOG.txt)
*-LOG.txt
# Editor / miz work dirs (e.g. temporary unpacks)
**/.tmp_*/
**/.tmp*/
**/_tmp*/
# Local scratch: directory or file name starts with _ (ME unpack, bftools _test*, etc.)
**/_*/
**/_*
# Local scratch in a named folder (create next to mission / miz as needed)
**/-pracovní_soubory-možno_smazat/
# Chat exports / saved threads (e.g. scenario `.../- chat/`)
**/- chat/
# bftools scratch (--output _test* / _t*); not mission release artifacts
**/_test*
**/_t*
bftools/analyze_export.ps1
bftools/analyze_export_detail.ps1
# Local Cursor IDE rules and settings (not shared via git)
.cursor/
# Attrition static site — local/DCS host only, not part of the engine repo
/website/
